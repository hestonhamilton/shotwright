{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-lint.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precompact-snapshot.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-coauthor.sh",
            "type": "command"
          },
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/branch-and-bd-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-orient.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "command -v bd >/dev/null 2>&1 && bd prime --hook-json || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd show*)",
      "Bash(bd ready*)",
      "Bash(bd list*)",
      "Bash(bd search*)",
      "Bash(bd blocked*)",
      "Bash(bd stats*)",
      "Bash(bd stale*)",
      "Bash(bd orphans*)",
      "Bash(bd lint*)",
      "Bash(bd memories*)",
      "Bash(bd prime*)",
      "Bash(bd dep list*)",
      "Bash(bd worktree list*)",
      "Bash(bd backup status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(bd dolt push*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -delete*)",
      "Bash(find * -fprint*)",
      "Bash(find * -fls*)"
    ]
  },
  "statusLine": {
    "command": "$CLAUDE_PROJECT_DIR/.claude/statusline.sh",
    "type": "command"
  }
}
